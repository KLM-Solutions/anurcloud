{
  "name": "plugins",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:templates": "node scripts/check-template-isolation.mjs",
    "verify:foundation": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolver.mjs scripts/verify-foundation.mts",
    "verify": "npm run check:templates && npm run verify:foundation && npm run stress && npm run check:overflow && npm run lint && npm run build",
    "preview": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolver.mjs scripts/build-preview.mts",
    "stress": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolver.mjs scripts/build-stress.mts",
    "check:overflow": "node scripts/check-overflow.mjs",
    "eval": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/ts-resolver.mjs scripts/eval-quality.mts",
    "pdf": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolver.mjs scripts/build-pdf.mts"
  },
  "dependencies": {
    "@llamaindex/llama-cloud": "^2.8.0",
    "@mendable/firecrawl-js": "^4.28.2",
    "next": "16.2.7",
    "openai": "^6.44.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
